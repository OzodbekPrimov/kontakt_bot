# Obtain this value from @BotFather. Never commit a real token.
BOT_TOKEN=replace-me
ADMIN_IDS=[]
# Server-side lookup is opt-in. Create a dedicated user StringSession securely.
LOOKUP_ENABLED=false
# LOOKUP_API_ID=123456
# LOOKUP_API_HASH=your-api-hash
# LOOKUP_SESSION_FILE=data/lookup-session.txt
# Alternatively: LOOKUP_SESSION=your-user-string-session
LOOKUP_FREE_LIMIT=5
